<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>eth_gateway</name>
  <version>0.1.0</version>
  <description>Jetson Ethernet BLOB v2 UDP gateway to /jetson_eth/* topics</description>
  <maintainer email="rxp@todo.todo">rxp</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>jetson_can_msgs</exec_depend>
  <exec_depend>ds_jetson_bridge</exec_depend>
  <exec_depend>rs232_gateway</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
